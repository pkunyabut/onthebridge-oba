# Copy this file to ".env" and fill in what you use. ".env" is git-ignored — never commit it,
# never paste its contents into an issue or a chat.
# One KEY=value per line, no quotes. Lines that start with # are comments.

# ── AI provider keys (you need at least one) ─────────────────────────────────
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Web search (optional but strongly recommended — without one, OBA falls back to Wikipedia + DuckDuckGo) ──
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ── Optional extras ──────────────────────────────────────────────────────────
# Used by the "Deep check" (Google Fact Check Tools API)
GOOGLE_FACTCHECK_API_KEY=
# Override the DeepSeek model name (default: deepseek-flash)
# DEEPSEEK_MODEL=
# Port of the local page (default 8080). The server always listens on 127.0.0.1 only.
# PORT=8080
# Used in the newsletter / caption / video-script drafts
# PUBLICATION_NAME=My Publication
# SITE_URL=https://example.com
# The goal shown by the progress bar on the Insights tab
# TARGET_ARTICLES=30
