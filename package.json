{
    "name":  "onthebridge-oba",
    "version":  "0.1.0",
    "description":  "OnTheBridge OBA - a semi-automatic article-writing system with a human gate: the AI researches, writes and checks; a person decides. Nothing is published by the system.",
    "license":  "MIT",
    "type":  "module",
    "main":  "src/server.mjs",
    "engines":  {
                    "node":  "\u003e=20.12"
                },
    "scripts":  {
                    "start":  "node src/server.mjs",
                    "mcp":  "node src/mcp-server.mjs",
                    "test":  "node --test tests/*.test.mjs"
                },
    "keywords":  [
                     "editorial",
                     "article-writing",
                     "human-in-the-loop",
                     "fact-checking",
                     "mcp",
                     "claude",
                     "deepseek"
                 ],
    "dependencies":  {
                         "@modelcontextprotocol/sdk":  "^1.32.1",
                         "exceljs":  "^4.4.0",
                         "mammoth":  "^1.12.3",
                         "pdfjs-dist":  "^6.4.299",
                         "zod":  "^4.6.7"
                     },
    "overrides":  {
                      "uuid":  "^11.1.1"
                  }
}
